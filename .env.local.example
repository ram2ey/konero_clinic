# PostgreSQL connection string for the app's database.
# Coolify injects this automatically when a Postgres resource is linked.
# Locally: postgres://user:password@localhost:5432/konero_dev
# Append ?sslmode=require for a database that needs TLS.
DATABASE_URL=

# Secret — server-only. HMAC key for the short-lived lab-file download
# tokens. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Absolute path to the directory that holds uploaded lab-report files.
# Mount a persistent volume here in production (e.g. /data/lab-documents).
STORAGE_DIR=./.lab-documents

# Public base URL of the deployment (used where an absolute URL is needed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
