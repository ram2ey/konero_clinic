# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build the invite email's redirect link (e.g. https://clinic.example.com).
NEXT_PUBLIC_SITE_URL=

# Secret — server-only. Bypasses RLS entirely. Never prefix with
# NEXT_PUBLIC_. Only read by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
