# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build the invite email's redirect link (e.g. https://clinic.example.com).
NEXT_PUBLIC_SITE_URL=

# Secret — server-only. Bypasses RLS entirely. Never prefix with
# NEXT_PUBLIC_. Only read by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Secret — server-only. WHO ICD-11 API (icd.who.int/icdapi) OAuth2
# client-credentials pair. Not currently read by any code — ICD-11
# diagnosis search runs against the local icd11_codes table instead
# (see supabase/migrations). Kept here in case live search is worth
# revisiting later.
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
